# Server-side only; never put credentials in frontend files.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_PASSWORD=replace-with-a-strong-password
PRODUCTION=true

# Optional: set when the frontend is hosted separately.
# ALLOWED_ORIGINS=https://your-portal.example.com

# Optional SMTP; required for production student email verification.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
# SMTP_SECURITY=starttls

# Optional AI and search integrations.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# SEARCH_KEY=
# SEARCH_CX=
